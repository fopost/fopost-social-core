# =============================================================================
# FoPost Social Core — Real API Examples Environment Variables
# =============================================================================
#
# Copy this file and fill in your real credentials:
#
#   cp .env.example .env
#   source .env      # or export variables individually
#
# ⚠️  NEVER commit a filled .env file to version control.
# ⚠️  These examples will post REAL content to your accounts.
# =============================================================================


# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram to get your API token.
# The channel username should include the @ prefix (e.g., @mychannel).
TELEGRAM_API_TOKEN=
TELEGRAM_CHANNEL=


# -----------------------------------------------------------------------------
# Twitter / X
# -----------------------------------------------------------------------------
# Create an app at https://developer.x.com/en/portal/dashboard
# Generate consumer keys and access tokens with Read and Write permissions.
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=


# -----------------------------------------------------------------------------
# Facebook
# -----------------------------------------------------------------------------
# Create an app at https://developers.facebook.com/apps/
# Generate a Page Access Token with pages_manage_posts permission.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=


# -----------------------------------------------------------------------------
# LinkedIn
# -----------------------------------------------------------------------------
# Create an app at https://www.linkedin.com/developers/apps
# Use either person_id (personal profile) or organization_id (company page).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=
# LINKEDIN_ORGANIZATION_ID=


# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------
# Bot mode: Create a bot at https://discord.com/developers/applications
# Webhook mode: Create a webhook in your Discord channel settings.
# Use EITHER bot_token + channel_id, OR webhook_url.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# DISCORD_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# Instagram
# -----------------------------------------------------------------------------
# Requires a Facebook App with Instagram Graph API access.
# See: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# A publicly accessible image URL is required for publishing.
INSTAGRAM_TEST_IMAGE_URL=https://picsum.photos/1080/1080


# -----------------------------------------------------------------------------
# Pinterest
# -----------------------------------------------------------------------------
# Create an app at https://developers.pinterest.com/apps/
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=


# -----------------------------------------------------------------------------
# Reddit
# -----------------------------------------------------------------------------
# Create an app at https://www.reddit.com/prefs/apps (script type).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=
REDDIT_USERNAME=
REDDIT_SUBREDDIT=test


# -----------------------------------------------------------------------------
# Slack
# -----------------------------------------------------------------------------
# Bot mode: Create an app at https://api.slack.com/apps with chat:write scope.
# Webhook mode: Create an Incoming Webhook in your Slack app settings.
# Use EITHER bot_token + channel, OR webhook_url.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# SLACK_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# Tumblr
# -----------------------------------------------------------------------------
# Register an app at https://www.tumblr.com/oauth/apps
# The blog_identifier is your blog name (e.g., myblog.tumblr.com).
TUMBLR_ACCESS_TOKEN=
TUMBLR_BLOG_IDENTIFIER=


# -----------------------------------------------------------------------------
# WhatsApp
# -----------------------------------------------------------------------------
# Set up WhatsApp Cloud API at https://developers.facebook.com/apps/
# The phone number must be in E.164 format (e.g., +1234567890).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
